# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - KAIRÓS
# ==============================================================================

# --- Supabase 1: Devocionais (Leitura Pública e Ingestão Diária) ---
DEVOTIONAL_SUPABASE_URL=https://seu-projeto-devocionais.supabase.co
DEVOTIONAL_SUPABASE_ANON_KEY=sua-anon-key-aqui
# Necessário nos scripts/GitHub Secrets para bypass de RLS no scraping (pegar_devo.yml):
DEVOTIONAL_SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-devocionais

# --- Supabase 2: Autenticação, Quizzes e Sincronização de Usuários ---
AUTH_SUPABASE_URL=https://seu-projeto-auth.supabase.co
AUTH_SUPABASE_ANON_KEY=sua-anon-key-aqui
AUTH_REDIRECT_URI=nhaapp://login-callback
# Necessário para geração de Quizzes (generate_quizzes.yml) e migrações:
LOGIN_SERVICE_KEY_SUPABASE=sua-service-role-key-auth
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-auth

# --- Google Gemini AI (Geração de Quizzes com IA) ---
GEMINI_API_KEY=sua-chave-gemini-aqui

# --- Google Sign-In (Web / OAuth) ---
GOOGLE_WEB_CLIENT_ID=seu-google-web-client-id.apps.googleusercontent.com
